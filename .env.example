# Copy to `.env` for local dev. `.env` is gitignored, so the deployed build
# gets these from Cloudflare instead: Settings -> Build -> "Variables and
# secrets" (build-time, not the runtime Variables & Secrets screen).
#
# VITE_ means Vite inlines the value into the client bundle: public by
# definition. Never put a secret here. The Conversions API token is a runtime
# secret read by worker/lead.ts — see .dev.vars.example.

# Meta Pixel dataset ID (Events Manager). Real IDs are 15-16 digits.
VITE_META_PIXEL_ID=1234567890
