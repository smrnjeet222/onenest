# Cloudflare's default for every static asset is `public, max-age=0,
# must-revalidate`. Prerendered HTML deliberately keeps that default so a deploy
# is visible immediately; the rules below override it only where the content is
# genuinely safe to cache.
# Applies to static assets only — Worker responses set their own headers.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Vite fingerprints these filenames, so a changed file is a changed URL and the
# old one can never be stale. Safe to cache for a year and skip revalidation.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Not fingerprinted, so they must stay revalidatable — but they change rarely.
# A day in cache, then a week of serving stale while refreshing in background.
/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Crawler-facing files: short cache so edits take effect the same day.
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
